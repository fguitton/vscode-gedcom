# The published extension ships the declarative language contribution and the
# two bundles. Everything that produces or verifies them stays out of the VSIX.

.github/**
.vscode/**
.vscode-test/**
node_modules/**
packages/**
fixtures/**
vendor/**

.gitattributes
.gitignore
.node-version
tsconfig.json
tsdown.config.ts
vite.config.ts
package-lock.json

# Source maps are for local debugging; they are larger than the code they map.
dist/**/*.map

# Not everything under dist/ is the extension. The web integration tests are
# bundled like an extension entry point, and the colour preview is a page for
# looking at the grammar — both land here and neither should ship. The preview
# is the sneakier of the two: it only exists once somebody has run `vp run
# preview`, so it would ride along on some machines and not others.
dist/web-tests/**
dist/preview/**
test/**

# README.md *is* the Marketplace listing, so it stays. Everything aimed at
# somebody working on the extension rather than using it does not.
CONTRIBUTING.md
