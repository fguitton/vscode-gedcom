# The published extension ships the declarative language contribution and the
# two bundles. Everything that produces or verifies them stays out of the VSIX.

.github/**
.vscode/**
.vscode-test/**
node_modules/**
packages/**
fixtures/**
vendor/**

.gitattributes
.gitignore
.node-version
tsconfig.json
tsdown.config.ts
vite.config.ts
package-lock.json

# Source maps are for local debugging; they are larger than the code they map.
dist/**/*.map

# The web integration tests are bundled like an extension entry point, which puts
# them in dist/. They are not part of the extension.
dist/web-tests/**
test/**
