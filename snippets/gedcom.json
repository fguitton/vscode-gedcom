{
  "Individual Record": {
    "prefix": "indi",
    "body": [
      "0 @${1:I1}@ INDI",
      "1 NAME ${2:Given} /${3:Surname}/",
      "1 SEX ${4|M,F,X,U|}",
      "1 BIRT",
      "2 DATE ${5:1 JAN 1900}",
      "2 PLAC ${6:City, County, State, Country}",
      "1 DEAT",
      "2 DATE ${7:1 JAN 1970}",
      "2 PLAC ${8:City, County, State, Country}"
    ],
    "description": "Create an individual (INDI) record"
  },
  "Family Record": {
    "prefix": "fam",
    "body": [
      "0 @${1:F1}@ FAM",
      "1 HUSB @${2:I1}@",
      "1 WIFE @${3:I2}@",
      "1 MARR",
      "2 DATE ${4:1 JAN 1920}",
      "2 PLAC ${5:City, County, State, Country}",
      "1 CHIL @${6:I3}@"
    ],
    "description": "Create a family (FAM) record"
  },
  "Source Record": {
    "prefix": "sour",
    "body": [
      "0 @${1:S1}@ SOUR",
      "1 TITL ${2:Source Title}",
      "1 AUTH ${3:Author}",
      "1 PUBL ${4:Publisher, Date}"
    ],
    "description": "Create a source (SOUR) record"
  },
  "Repository Record": {
    "prefix": "repo",
    "body": [
      "0 @${1:R1}@ REPO",
      "1 NAME ${2:Repository Name}",
      "1 ADDR",
      "2 CITY ${3:City}",
      "2 CTRY ${4:Country}"
    ],
    "description": "Create a repository (REPO) record"
  },
  "Birth Event": {
    "prefix": "birt",
    "body": ["1 BIRT", "2 DATE ${1:1 JAN 1900}", "2 PLAC ${2:City, County, State, Country}"],
    "description": "Add a birth (BIRT) event"
  },
  "Death Event": {
    "prefix": "deat",
    "body": ["1 DEAT", "2 DATE ${1:1 JAN 1970}", "2 PLAC ${2:City, County, State, Country}"],
    "description": "Add a death (DEAT) event"
  },
  "Marriage Event": {
    "prefix": "marr",
    "body": ["1 MARR", "2 DATE ${1:1 JAN 1920}", "2 PLAC ${2:City, County, State, Country}"],
    "description": "Add a marriage (MARR) event"
  },
  "Burial Event": {
    "prefix": "buri",
    "body": [
      "1 BURI",
      "2 DATE ${1:1 JAN 1970}",
      "2 PLAC ${2:Cemetery, City, County, State, Country}"
    ],
    "description": "Add a burial (BURI) event"
  },
  "Census Event": {
    "prefix": "cens",
    "body": ["1 CENS", "2 DATE ${1:1 JAN 1900}", "2 PLAC ${2:City, County, State, Country}"],
    "description": "Add a census (CENS) event"
  },
  "Occupation Attribute": {
    "prefix": "occu",
    "body": [
      "1 OCCU ${1:Occupation}",
      "2 DATE ${2:1900-1950}",
      "2 PLAC ${3:City, County, State, Country}"
    ],
    "description": "Add an occupation (OCCU) attribute"
  },
  "Residence Attribute": {
    "prefix": "resi",
    "body": ["1 RESI", "2 DATE ${1:1900}", "2 PLAC ${2:City, County, State, Country}"],
    "description": "Add a residence (RESI) attribute"
  },
  "Note Structure": {
    "prefix": "note",
    "body": ["1 NOTE ${1:Note text}", "2 CONT ${2:Continuation text}"],
    "description": "Add a note (NOTE) structure"
  }
}
