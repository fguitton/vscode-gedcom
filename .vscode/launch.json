{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Extension (desktop)",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "${workspaceFolder}/fixtures"
            ]
        },
        {
            // The extension is purely declarative, so it already runs in the web
            // extension host. This keeps that true as runtime code lands.
            "name": "Extension (web)",
            "type": "extensionHost",
            "debugWebWorkerHost": true,
            "request": "launch",
            "args": [
                "--extensionDevelopmentKind=web",
                "--extensionDevelopmentPath=${workspaceFolder}",
                "${workspaceFolder}/fixtures"
            ]
        }
    ]
}
