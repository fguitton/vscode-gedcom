{
  "name": "vscode-gedcom",
  "displayName": "GEDCOM Language",
  "version": "0.5.0",
  "private": false,
  "description": "GEDCOM language support for VS Code: syntax highlighting, validation, navigation and a family graph for GEDCOM 5.5.1, 5.5.5 and FamilySearch GEDCOM 7",
  "categories": [
    "Linters",
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "family tree",
    "familysearch",
    "ged",
    "gedcom",
    "genealogy"
  ],
  "homepage": "https://github.com/fguitton/vscode-gedcom/blob/master/README.md",
  "bugs": {
    "url": "https://github.com/fguitton/vscode-gedcom/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Florian Guitton",
    "url": "https://github.com/fguitton"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fguitton/vscode-gedcom"
  },
  "publisher": "florianguitton",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "main": "./dist/node/extension.cjs",
  "browser": "./dist/browser/extension.cjs",
  "scripts": {
    "test": "vp test",
    "check": "vp check"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "~1.91.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "tsdown": "^0.22.14",
    "vite-plus": "^0.2.9",
    "vscode-languageclient": "^10.1.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.13",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "gedcom",
        "aliases": [
          "GEDCOM",
          "gedcom"
        ],
        "extensions": [
          ".ged",
          ".gedcom"
        ],
        "firstLine": "^\\uFEFF?0\\s+HEAD\\s*$",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gedcom",
        "scopeName": "source.gedcom",
        "path": "./syntaxes/gedcom.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "gedcom",
        "scopes": {
          "property.defaultLibrary": [
            "entity.name.tag.gedcom"
          ],
          "property": [
            "entity.name.tag.unknown.gedcom"
          ],
          "macro": [
            "entity.name.tag.extension.gedcom"
          ],
          "class.declaration": [
            "entity.name.type.xref.gedcom"
          ],
          "variable": [
            "variable.other.xref.gedcom"
          ],
          "variable.deprecated": [
            "invalid.deprecated.xref.gedcom"
          ],
          "keyword": [
            "constant.language.void.gedcom"
          ],
          "property.deprecated": [
            "invalid.deprecated.tag.gedcom"
          ],
          "class.unreferenced": [
            "comment.unreferenced.xref.gedcom",
            "entity.name.type.xref.gedcom"
          ],
          "operator.uncertain": [
            "markup.italic.date.uncertain.gedcom",
            "keyword.operator.date.gedcom"
          ],
          "operator": [
            "keyword.operator.date.gedcom"
          ],
          "property.individual": [
            "entity.name.tag.attribute.gedcom"
          ],
          "property.family": [
            "entity.name.tag.attribute.gedcom"
          ],
          "property.source": [
            "markup.quote.evidence.gedcom"
          ]
        }
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "gedcom",
          "title": "GEDCOM",
          "icon": "images/graph.svg"
        }
      ]
    },
    "views": {
      "gedcom": [
        {
          "type": "webview",
          "id": "gedcom.graph",
          "name": "Graph",
          "contextualTitle": "GEDCOM Graph",
          "when": "editorLangId == gedcom || resourceLangId == gedcom"
        }
      ]
    },
    "configuration": {
      "title": "GEDCOM",
      "properties": {
        "gedcom.graph.depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 2,
          "markdownDescription": "How many hops from the record at the cursor the graph panel shows.\n\nOne shows a person and their families; two also reaches spouses, children and parents. Beyond three the neighbourhood is usually larger than the panel can show usefully."
        },
        "gedcom.graph.includeReferences": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Include sources, notes and media in the graph alongside relatives.\n\nOff by default: a well-sourced person cites dozens of records, and they crowd out the family the panel exists to show."
        },
        "gedcom.validation.strictness": {
          "type": "string",
          "enum": [
            "auto",
            "strict",
            "lenient"
          ],
          "enumDescriptions": [
            "Follow the file's own version: strict for GEDCOM 7, lenient for 5.5.x and for files too old or damaged to identify.",
            "Enforce placement and cardinality rules on every file, whatever version it claims.",
            "Report only what is unambiguously wrong: malformed lines, dangling pointers, duplicate identifiers."
          ],
          "default": "auto",
          "markdownDescription": "How strictly to validate GEDCOM structure.\n\nTwo decades of exporters produced 5.5.1 files that violate the specification in ways every consumer tolerates, which is why `auto` does not apply GEDCOM 7's rules to them."
        },
        "gedcom.inlayHints.pointers": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show what each cross-reference points at, inline after the pointer.\n\nA GEDCOM file is mostly identifiers, and `1 FAMS @F1@` says nothing about the family it names without following it. This puts the answer at the end of the line."
        },
        "gedcom.inlayHints.values": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show what coded payloads mean, inline after the value.\n\nCovers enumerated values such as `SEX`, `QUAY` and `PEDI`, and BCP 47 language tags."
        },
        "gedcom.inlayHints.ages": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show how old the subject was, inline after an event's date.\n\nComputed against the record's own `BIRT` date, so it only appears where the file records one."
        },
        "gedcom.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a summary above each record: how many people depend on it, its shape in the tree, and a link into the graph panel."
        },
        "gedcom.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the GEDCOM language server."
        }
      }
    },
    "commands": [
      {
        "command": "gedcom.showGraph",
        "title": "Show Graph",
        "category": "GEDCOM",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "gedcom.showVersion",
        "title": "Explain Detected Version",
        "category": "GEDCOM"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gedcom.showGraph",
          "when": "editorLangId == gedcom",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "gedcom.showGraph",
          "when": "editorLangId == gedcom"
        },
        {
          "command": "gedcom.showVersion",
          "when": "editorLangId == gedcom"
        }
      ]
    }
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#003058",
    "theme": "dark"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0",
    "vscode": "^1.91.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  }
}
