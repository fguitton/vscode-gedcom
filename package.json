{
  "name": "vscode-gedcom",
  "displayName": "%extension.displayName%",
  "version": "0.12.1",
  "private": false,
  "description": "%extension.description%",
  "categories": [
    "Linters",
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "family tree",
    "familysearch",
    "ged",
    "gedcom",
    "genealogy"
  ],
  "homepage": "https://github.com/fguitton/vscode-gedcom/blob/master/README.md",
  "bugs": {
    "url": "https://github.com/fguitton/vscode-gedcom/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Florian Guitton",
    "url": "https://github.com/fguitton"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fguitton/vscode-gedcom"
  },
  "publisher": "florianguitton",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "main": "./dist/node/extension.cjs",
  "browser": "./dist/browser/extension.cjs",
  "scripts": {
    "test": "vp test",
    "check": "vp check"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.3",
    "@primer/primitives": "^11.10.0",
    "@types/node": "^26.2.0",
    "@types/vscode": "~1.91.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "@wooorm/starry-night": "^3.10.0",
    "tsdown": "^0.22.14",
    "vite-plus": "^0.2.9",
    "vscode-languageclient": "^10.1.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.13",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "glob": "^13.0.6",
    "serialize-javascript": "^7.1.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "gedcom",
        "aliases": [
          "GEDCOM",
          "gedcom"
        ],
        "extensions": [
          ".ged",
          ".gedcom"
        ],
        "firstLine": "^\\uFEFF?0\\s+HEAD\\s*$",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gedcom",
        "scopeName": "source.gedcom",
        "path": "./syntaxes/gedcom.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "gedcom",
        "path": "./snippets/gedcom.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "gedcom",
        "scopes": {
          "property.defaultLibrary": [
            "entity.name.tag.gedcom"
          ],
          "property": [
            "entity.name.tag.unknown.gedcom"
          ],
          "macro": [
            "entity.name.tag.extension.gedcom"
          ],
          "class.declaration": [
            "entity.name.type.xref.gedcom"
          ],
          "variable": [
            "variable.other.xref.gedcom"
          ],
          "variable.deprecated": [
            "invalid.deprecated.xref.gedcom"
          ],
          "keyword": [
            "constant.language.void.gedcom"
          ],
          "property.deprecated": [
            "invalid.deprecated.tag.gedcom"
          ],
          "class.unreferenced": [
            "comment.unreferenced.xref.gedcom",
            "entity.name.type.xref.gedcom"
          ],
          "operator.uncertain": [
            "markup.italic.date.uncertain.gedcom",
            "keyword.operator.date.gedcom"
          ],
          "operator": [
            "keyword.operator.date.gedcom"
          ],
          "property.individual": [
            "entity.name.tag.attribute.gedcom"
          ],
          "property.family": [
            "entity.name.tag.attribute.gedcom"
          ],
          "property.source": [
            "markup.quote.evidence.gedcom"
          ]
        }
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "gedcom",
          "title": "GEDCOM",
          "icon": "images/graph.svg"
        }
      ]
    },
    "views": {
      "gedcom": [
        {
          "type": "webview",
          "id": "gedcom.graph",
          "name": "%views.graph.name%",
          "contextualTitle": "%views.graph.contextualTitle%"
        },
        {
          "type": "webview",
          "id": "gedcom.details",
          "name": "%views.details.name%",
          "contextualTitle": "%views.details.contextualTitle%"
        }
      ]
    },
    "configuration": {
      "title": "GEDCOM",
      "properties": {
        "gedcom.graph.depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 2,
          "markdownDescription": "%config.graph.depth.markdownDescription%"
        },
        "gedcom.graph.includeReferences": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.graph.includeReferences.markdownDescription%"
        },
        "gedcom.validation.strictness": {
          "type": "string",
          "enum": [
            "auto",
            "strict",
            "lenient"
          ],
          "enumDescriptions": [
            "%config.validation.strictness.enumDescriptions.auto%",
            "%config.validation.strictness.enumDescriptions.strict%",
            "%config.validation.strictness.enumDescriptions.lenient%"
          ],
          "default": "auto",
          "markdownDescription": "%config.validation.strictness.markdownDescription%"
        },
        "gedcom.inlayHints.pointers": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.inlayHints.pointers.markdownDescription%"
        },
        "gedcom.inlayHints.values": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.inlayHints.values.markdownDescription%"
        },
        "gedcom.inlayHints.ages": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.inlayHints.ages.markdownDescription%"
        },
        "gedcom.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.codeLens.enabled.markdownDescription%"
        },
        "gedcom.details.imagePreviews": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.details.imagePreviews.markdownDescription%"
        },
        "gedcom.details.noteFormat": {
          "type": "string",
          "enum": [
            "text",
            "html"
          ],
          "enumDescriptions": [
            "%config.details.noteFormat.enumDescriptions.text%",
            "%config.details.noteFormat.enumDescriptions.html%"
          ],
          "default": "text",
          "markdownDescription": "%config.details.noteFormat.markdownDescription%"
        },
        "gedcom.virtualIndent.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.virtualIndent.enabled.markdownDescription%"
        },
        "gedcom.virtualIndent.width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 2,
          "markdownDescription": "%config.virtualIndent.width.markdownDescription%"
        },
        "gedcom.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "%config.trace.server.description%"
        }
      }
    },
    "commands": [
      {
        "command": "gedcom.showGraph",
        "title": "%command.showGraph%",
        "category": "GEDCOM",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "gedcom.showVersion",
        "title": "%command.showVersion%",
        "category": "GEDCOM"
      },
      {
        "command": "gedcom.showLog",
        "title": "%command.showLog%",
        "category": "GEDCOM"
      },
      {
        "command": "gedcom.copyDiagnostics",
        "title": "%command.copyDiagnostics%",
        "category": "GEDCOM"
      },
      {
        "command": "gedcom.upgradeToGedcom7",
        "title": "%command.upgradeToGedcom7%",
        "category": "GEDCOM"
      },
      {
        "command": "gedcom.findRelationship",
        "title": "%command.findRelationship%",
        "category": "GEDCOM"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gedcom.showGraph",
          "when": "editorLangId == gedcom",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "gedcom.findRelationship",
          "when": "editorLangId == gedcom",
          "group": "gedcom@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gedcom.showGraph",
          "when": "editorLangId == gedcom"
        },
        {
          "command": "gedcom.findRelationship",
          "when": "editorLangId == gedcom"
        },
        {
          "command": "gedcom.showVersion",
          "when": "editorLangId == gedcom"
        },
        {
          "command": "gedcom.upgradeToGedcom7",
          "when": "editorLangId == gedcom"
        },
        {
          "command": "gedcom.showLog"
        },
        {
          "command": "gedcom.copyDiagnostics"
        }
      ]
    }
  },
  "activationEvents": [
    "onLanguage:gedcom",
    "workspaceContains:**/*.ged",
    "workspaceContains:**/*.gedcom"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#003058",
    "theme": "dark"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0",
    "vscode": "^1.91.0"
  },
  "allowScripts": {
    "@playwright/browser-chromium@1.62.1": true
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  }
}
